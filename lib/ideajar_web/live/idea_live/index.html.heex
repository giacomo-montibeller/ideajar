<Layouts.app flash={@flash}>
  <section class="space-y-6">
    <button
      id="add-idea-button"
      type="button"
      phx-click="toggle_form"
      class="btn btn-primary"
    >
      + Aggiungi idea
    </button>

    <.form
      :if={@form_visible?}
      for={@form}
      id="idea-form"
      phx-submit={if match?({:edit, _}, @form_mode), do: "submit_edit", else: "save"}
      phx-window-keydown={if match?({:edit, _}, @form_mode), do: "cancel_edit"}
      phx-key="Escape"
      class="space-y-4 rounded-box border border-base-300 p-4"
    >
      <div class="flex items-start justify-between gap-2">
        <h2 class="text-base font-semibold">
          {if match?({:edit, _}, @form_mode), do: "Modifica idea", else: "Aggiungi idea"}
        </h2>
        <button
          type="button"
          aria-label="Chiudi"
          phx-click="close_form"
          class="btn btn-ghost btn-sm min-h-11 min-w-11 text-base-content/60"
        >
          ✕
        </button>
      </div>

      <.input field={@form[:title]} id="idea-title" label="Titolo" required />
      <.input
        field={@form[:description]}
        id="idea-description"
        label="Descrizione"
        type="textarea"
      />
      <.input field={@form[:url]} id="idea-url" label="Link" type="url" />

      <fieldset class="fieldset">
        <legend class="label mb-1">
          Categorie <span aria-hidden="true">*</span>
          <span class="sr-only">obbligatorio</span>
        </legend>
        <p id="idea-categories-help" class="text-sm text-base-content/70 mb-2">
          Scegli almeno una categoria
        </p>
        <div class="flex flex-wrap gap-2">
          <.category_chip
            :for={category <- @categories}
            id={category.id}
            name={category.name}
            emoji={category.emoji}
            selected?={MapSet.member?(@selected_category_ids, category.id)}
            aria_describedby={chip_describedby(@form)}
          />
        </div>
        <p
          :if={has_categories_error?(@form)}
          id="idea-categories-error"
          tabindex="-1"
          class="mt-1.5 flex gap-2 items-center text-sm text-error"
        >
          <.icon name="hero-exclamation-circle" class="size-5" />
          {categories_error_message(@form)}
        </p>
      </fieldset>

      <fieldset class="fieldset" id="idea-target-fieldset">
        <legend id="idea-target-legend" class="label mb-1">Quando</legend>
        <p id="idea-target-help" class="text-sm text-base-content/70 mb-2">
          Quando pensi di farlo?
        </p>
        <div class="flex gap-3 mb-2">
          <label class="cursor-pointer flex items-center gap-1">
            <input
              type="radio"
              name="target_granularity_radio"
              value="day"
              checked={@target_window.granularity == :day}
              phx-click="set_target_granularity"
              phx-value-granularity="day"
            /> Giorni
          </label>
          <label class="cursor-pointer flex items-center gap-1">
            <input
              type="radio"
              name="target_granularity_radio"
              value="month"
              checked={@target_window.granularity == :month}
              phx-click="set_target_granularity"
              phx-value-granularity="month"
            /> Mesi
          </label>
        </div>

        <form
          id="idea-target-day-form"
          phx-change="update_target_window"
          class="flex gap-2 mb-2"
          hidden={@target_window.granularity != :day}
          aria-hidden={@target_window.granularity != :day}
        >
          <label class="flex flex-col text-xs">
            Inizio
            <input
              type="date"
              name="target_start"
              aria-label="Data inizio"
              aria-describedby={if has_target_error?(@form), do: "idea-target-error"}
              value={target_iso_date(@target_window.start)}
              class="input"
            />
          </label>
          <label class="flex flex-col text-xs">
            Fine
            <input
              type="date"
              name="target_end"
              aria-label="Data fine"
              aria-describedby={if has_target_error?(@form), do: "idea-target-error"}
              value={target_iso_date(@target_window.end)}
              class="input"
            />
          </label>
        </form>

        <form
          id="idea-target-month-form"
          phx-change="update_target_window"
          class="flex gap-2 mb-2"
          hidden={@target_window.granularity != :month}
          aria-hidden={@target_window.granularity != :month}
        >
          <label class="flex flex-col text-xs">
            Inizio
            <input
              type="month"
              name="target_start_month"
              aria-label="Mese inizio"
              aria-describedby={if has_target_error?(@form), do: "idea-target-error"}
              value={target_iso_month(@target_window.start)}
              class="input"
            />
          </label>
          <label class="flex flex-col text-xs">
            Fine
            <input
              type="month"
              name="target_end_month"
              aria-label="Mese fine"
              aria-describedby={if has_target_error?(@form), do: "idea-target-error"}
              value={target_iso_month(@target_window.end)}
              class="input"
            />
          </label>
        </form>

        <label
          class="cursor-pointer flex items-center gap-1 mb-2"
          hidden={@target_window.granularity != :month}
          aria-hidden={@target_window.granularity != :month}
        >
          <input
            type="checkbox"
            checked={@target_window.weekend_only}
            phx-click="toggle_target_weekend_only"
          /> Solo nei weekend
        </label>

        <p
          aria-live="polite"
          aria-atomic="true"
          data-testid="target-window-preview"
          class="text-sm text-base-content/80 mb-1"
        >
          {@target_window.preview}
        </p>

        <button
          type="button"
          phx-click="clear_target_window"
          class="btn btn-ghost btn-xs"
        >
          Rimuovi quando
        </button>

        <p
          :if={has_target_error?(@form)}
          id="idea-target-error"
          class="mt-1.5 flex gap-2 items-center text-sm text-error"
          role="alert"
        >
          <.icon name="hero-exclamation-circle" class="size-5" />
          {target_error_message(@form)}
        </p>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="label mb-1">Durata</legend>
        <div class="flex flex-wrap gap-2">
          <.form_chip
            :for={duration <- Ideajar.Ideas.Duration.values()}
            duration={duration}
            pressed?={@selected_duration == duration}
          />
        </div>
        <p
          :if={has_duration_error?(@form)}
          id="idea-duration-error"
          class="mt-1.5 flex gap-2 items-center text-sm text-error"
          role="alert"
        >
          <.icon name="hero-exclamation-circle" class="size-5" />
          {duration_error_message(@form)}
        </p>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="label mb-1">Budget</legend>
        <input
          type="range"
          id="form-budget-slider"
          name="idea[budget]"
          min="0"
          max="7"
          step="1"
          value={@form_budget_index}
          phx-change="update_form_budget"
          phx-debounce="200"
          aria-valuemin="0"
          aria-valuemax="7"
          aria-valuenow={@form_budget_index}
          aria-valuetext={IdeajarWeb.Components.BudgetLabels.form(@form_budget_index)}
          class="range range-sm w-full"
        />
        <p class="text-sm">
          Budget: {IdeajarWeb.Components.BudgetLabels.form(@form_budget_index)}
        </p>
        <button
          :if={@form_budget_index > 0}
          type="button"
          phx-click="remove_form_budget"
          class="btn btn-ghost btn-sm min-h-11 min-w-11"
        >
          Rimuovi prezzo
        </button>
        <p
          :if={has_estimated_cost_error?(@form)}
          id="idea-estimated-cost-error"
          class="mt-1.5 flex gap-2 items-center text-sm text-error"
          role="alert"
        >
          <.icon name="hero-exclamation-circle" class="size-5" />
          {estimated_cost_error_message(@form)}
        </p>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="label mb-1">Posizione</legend>
        <label for="idea-location-name" class="label">Luogo</label>
        <.location_search_input
          id="idea-location-name"
          name="idea[location_name]"
          name_value={@selected_location_name || ""}
          placeholder="es. Casa di nonna"
          search_results={@location_search_results}
          search_state={@location_search_state}
          on_change_event="update_location_name"
          on_select_event="select_location"
          on_dismiss_event="dismiss_location_search"
        />
        <button
          :if={not is_nil(@selected_location_name) or not is_nil(@selected_lat)}
          type="button"
          phx-click="remove_location"
          class="btn btn-ghost btn-sm min-h-11 min-w-11"
        >
          Rimuovi posizione
        </button>
      </fieldset>

      <div class="flex items-center gap-2">
        <button type="submit" phx-disable-with="Salvataggio…" class="btn btn-primary">
          {if match?({:edit, _}, @form_mode), do: "Salva modifiche", else: "Salva"}
        </button>
        <button
          :if={match?({:edit, _}, @form_mode)}
          type="button"
          phx-click="cancel_edit"
          class="btn btn-ghost"
        >
          Annulla
        </button>
      </div>
    </.form>

    <section
      data-testid="filter-row"
      aria-label="Filtra per:"
      class="border-t border-base-300 pt-4 space-y-2"
    >
      <button
        type="button"
        phx-click="toggle_filters"
        aria-expanded={if @filters_expanded?, do: "true", else: "false"}
        aria-controls="filter-row-body"
        class="btn btn-ghost btn-sm w-full justify-between min-h-11"
      >
        <span class="text-sm font-semibold">
          Filtri{if (n = active_filter_axes_count(assigns)) > 0, do: " (#{n})", else: ""}
        </span>
        <span aria-hidden="true">{if @filters_expanded?, do: "▾", else: "▸"}</span>
      </button>

      <div :if={@filters_expanded?} id="filter-row-body" class="space-y-2">
        <p id="filter-helper" class="text-sm text-base-content/70">
          Tocca per filtrare: 1× opzionale · 2× obbligatoria · 3× rimuovi
        </p>
        <p class="text-xs">Categorie</p>
        <div
          id="filter-categories-group"
          role="group"
          aria-label="Filtra per categoria"
          data-roving-tabindex-group="filter-categories"
          phx-hook="RovingTabindex"
          class="flex flex-wrap gap-2"
        >
          <.filter_chip
            :for={{category, idx} <- Enum.with_index(@categories)}
            id={category.id}
            name={category.name}
            emoji={category.emoji}
            state={Map.get(@filter_state, category.id, :off)}
            aria_describedby="filter-helper"
            tabindex={if idx == 0, do: 0, else: -1}
          />
        </div>
        <p class="text-xs">Durata</p>
        <p class="text-xs text-base-content/70">
          Le idee senza durata sono nascoste quando un filtro è attivo.
        </p>
        <div
          id="filter-durations-group"
          role="group"
          aria-label="Filtra per durata"
          data-roving-tabindex-group="filter-durations"
          phx-hook="RovingTabindex"
          class="flex flex-wrap gap-2"
        >
          <DurationChip.filter_chip
            :for={{duration, idx} <- Enum.with_index(Ideajar.Ideas.Duration.values())}
            duration={duration}
            state={if MapSet.member?(@duration_filter, duration), do: :on, else: :off}
            tabindex={if idx == 0, do: 0, else: -1}
          />
        </div>
        <p class="text-xs">Budget</p>
        <p class="text-xs text-base-content/70">
          Le idee senza prezzo sono nascoste quando un filtro è attivo.
        </p>
        <div
          id="filter-budget-group"
          role="group"
          aria-label="Filtra per budget"
          class="space-y-2"
        >
          <form
            id="filter-budget-slider-form"
            phx-change="update_max_budget"
            class="contents"
          >
            <input
              type="range"
              id="filter-budget-slider"
              min="0"
              max="7"
              step="1"
              value={@max_budget_index}
              phx-debounce="200"
              name="filter[budget]"
              aria-valuemin="0"
              aria-valuemax="7"
              aria-valuenow={@max_budget_index}
              aria-valuetext={IdeajarWeb.Components.BudgetLabels.filter(@max_budget_index)}
              class="range range-sm w-full"
            />
          </form>
          <p class="text-sm">
            Budget: {IdeajarWeb.Components.BudgetLabels.filter(@max_budget_index)}
          </p>
          <button
            :if={@max_budget_index > 0}
            type="button"
            phx-click="remove_budget_filter"
            class="btn btn-ghost btn-sm min-h-11 min-w-11"
          >
            Rimuovi filtro budget
          </button>
        </div>
        <p class="text-xs">Distanza</p>
        <p class="text-xs text-base-content/70">
          Le idee senza posizione sono nascoste quando un filtro è attivo.
        </p>
        <div
          id="filter-distance-group"
          role="group"
          aria-label="Filtra per distanza"
          class="space-y-2"
        >
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <button
              id="user-location-button"
              type="button"
              phx-hook="Geolocation"
              class="btn btn-sm min-h-11 min-w-11"
            >
              <span aria-hidden="true">📍</span> Usa la mia posizione
            </button>
            <form
              id="filter-distance-search-form"
              phx-change="update_user_location_name"
              class="flex-1"
            >
              <.location_search_input
                id="filter-location-search"
                name="filter[user_location_name]"
                name_value={@user_location_search_query}
                placeholder="Cerca punto di partenza"
                search_results={@user_location_search_results}
                search_state={@user_location_search_state}
                on_change_event="update_user_location_name"
                on_select_event="select_user_location"
                on_dismiss_event="dismiss_user_location_search"
              />
            </form>
          </div>

          <p :if={is_nil(@user_lat)} class="text-xs text-base-content/70">
            Imposta un punto di riferimento per usare il filtro distanza
          </p>

          <p :if={not is_nil(@user_lat)} class="text-sm">
            Punto di riferimento: {@user_location_name}
          </p>

          <form
            id="filter-distance-slider-form"
            phx-change="update_max_distance"
            class="contents"
          >
            <input
              type="range"
              id="filter-distance-slider"
              min="0"
              max="6"
              step="1"
              value={@max_distance_index}
              phx-debounce="200"
              name="value"
              disabled={is_nil(@user_lat)}
              aria-disabled={if is_nil(@user_lat), do: "true", else: "false"}
              aria-valuemin="0"
              aria-valuemax="6"
              aria-valuenow={@max_distance_index}
              aria-valuetext={distance_label(@max_distance_index)}
              class={[
                "range range-sm w-full",
                is_nil(@user_lat) && "opacity-50 cursor-not-allowed"
              ]}
            />
          </form>

          <p class="text-sm">Distanza: {distance_label(@max_distance_index)}</p>

          <button
            :if={not is_nil(@user_lat)}
            type="button"
            phx-click="remove_user_location"
            class="btn btn-ghost btn-sm min-h-11 min-w-11"
          >
            Rimuovi punto di riferimento
          </button>

          <button
            :if={@max_distance_index > 0}
            type="button"
            phx-click="remove_distance_filter"
            class="btn btn-ghost btn-sm min-h-11 min-w-11"
          >
            Rimuovi filtro distanza
          </button>
        </div>
        <p class="text-xs">Testo</p>
        <p class="text-xs text-base-content/70">
          La ricerca trova le idee con la parola in titolo o descrizione.
        </p>
        <div
          id="filter-text-group"
          role="group"
          aria-label="Filtra per testo"
          class="space-y-2"
        >
          <form id="filter-text-search-form" phx-change="update_text_search">
            <input
              type="text"
              id="filter-text-search-input"
              name="filter[text_search]"
              value={@text_search_query}
              placeholder="Cerca idee"
              phx-debounce="300"
              maxlength="200"
              autocomplete="off"
              class="input w-full"
            />
          </form>
          <button
            :if={@text_search_query != ""}
            type="button"
            phx-click="remove_text_search"
            class="btn btn-ghost btn-sm min-h-11 min-w-11"
          >
            Rimuovi filtro testo
          </button>
        </div>
        <button
          :if={filter_active?(assigns) and @ideas != []}
          id="mostra-tutte"
          type="button"
          phx-click="clear_filters"
          class="btn btn-ghost btn-sm"
        >
          Mostra tutte
        </button>
      </div>
    </section>

    <p
      :if={@ideas == [] and not filter_active?(assigns)}
      class="text-base-content/70"
    >
      Nessuna idea ancora. Aggiungine una qui sopra.
    </p>

    <div
      :if={@ideas == [] and filter_active?(assigns)}
      data-testid="empty-filter-state"
      class="rounded-box border border-base-300 p-4 space-y-3"
    >
      <p class="flex items-center gap-2 text-base-content/80">
        <.icon name="hero-funnel" class="size-5" /> Nessuna idea per i filtri attivi.
      </p>
      <button
        id="mostra-tutte-empty"
        type="button"
        phx-click="clear_filters"
        class="btn btn-primary btn-sm"
      >
        Mostra tutte
      </button>
    </div>

    <ul :if={@ideas != []} class="space-y-4">
      <li
        :for={idea <- @ideas}
        data-testid="idea-card"
        class="rounded-box border border-base-300 p-4 space-y-2"
      >
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-base font-semibold">{idea.title}</h3>
          <div class="flex items-center gap-1">
            <button
              id={"edit-btn-#{idea.id}"}
              type="button"
              aria-label={"Modifica #{idea.title}"}
              phx-click="request_edit"
              phx-value-id={idea.id}
              class="edit-btn min-w-[44px] min-h-[44px] flex items-center justify-center text-base-content/60 hover:text-primary rounded-md"
            >
              ✏️
            </button>
            <button
              id={"delete-btn-#{idea.id}"}
              type="button"
              aria-label="Elimina idea"
              phx-click="request_delete"
              phx-value-id={idea.id}
              class="trash-btn min-w-[44px] min-h-[44px] flex items-center justify-center text-base-content/60 hover:text-error rounded-md"
            >
              🗑
            </button>
          </div>
        </div>
        <p
          :if={idea.description not in [nil, ""]}
          data-testid="idea-description"
          class="whitespace-pre-wrap text-base-content/80"
        >
          {idea.description}
        </p>
        <p :if={idea.url not in [nil, ""]}>
          <a
            href={idea.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Apri link in una nuova scheda"
            class="link link-primary break-all"
          >
            {idea.url}
          </a>
        </p>
        <ul
          :if={idea.categories != []}
          aria-label="Categorie"
          data-testid="idea-categories"
          class="flex flex-wrap gap-2 mt-2"
        >
          <li
            :for={cat <- idea.categories}
            class="category-badge px-2 py-1 rounded-full border border-base-300 text-xs text-base-content/80"
          >
            {cat.emoji} {cat.name}
          </li>
        </ul>
        <TargetWindowBadge.target_window_badge :if={not is_nil(idea.target_start)} idea={idea} />
        <.duration_badge :if={idea.duration} duration={idea.duration} />
        <BudgetBadge.badge
          :if={not is_nil(idea.estimated_cost)}
          cost={idea.estimated_cost}
        />
        <LocationBadge.location_badge
          :if={not is_nil(idea.location_name)}
          name={idea.location_name}
        />
      </li>
    </ul>

    <div
      :if={@deletion}
      role="dialog"
      aria-modal="true"
      aria-labelledby="delete-modal-title"
      aria-describedby="delete-modal-body"
      id="delete-modal"
      phx-window-keydown="cancel_delete"
      phx-key="Escape"
      class="fixed inset-0 z-50 flex items-center justify-center"
    >
      <div class="backdrop" phx-click="cancel_delete"></div>
      <div class="dialog relative z-10 max-w-md w-full mx-4 bg-base-100 rounded-box border border-base-300 p-6 space-y-4">
        <h2 id="delete-modal-title" class="text-lg font-semibold">Eliminare questa idea?</h2>
        <p id="delete-modal-body" class="text-base-content/80">
          {"Elimina l'idea \"#{@deletion.title}\". L'idea sarà rimossa definitivamente."}
        </p>
        <div class="flex justify-end gap-2">
          <button
            id="delete-cancel-btn"
            type="button"
            phx-click="cancel_delete"
            class="btn btn-ghost"
          >
            Annulla
          </button>
          <button
            type="button"
            phx-click="confirm_delete"
            phx-disable-with="Eliminazione…"
            class="btn bg-red-700 hover:bg-red-800 text-white"
          >
            Elimina
          </button>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
